<h1>Admin Dashboard</h1>

<div class="flex justify-between flex-wrap mt-8 w-full items-center max-w-4xl">
    <h2 class="text-2xl tect-gray-800 font-meduim mb-4"> Daily Stats</h2>
    <div class="flex gap-10 flex-col md:flex-row justify-between w-full">
        <div class="max-w-sm rounded overflow-hidden shadow-xl bg-linear-to-r form-gray-400 to-gray-400">
            <div class="px-6 py-4">
                <div class="font-bold text-xl mb-2 text-black">Revenue</div>
                <p class="text-black text-base">
                    $<%= @quick_stats[:revenue] ? (@quick_stats[:revenue]/100.0).to_s : "0" %>
                </p>
            </div>
        </div>
        <div class="max-w-sm rounded overflow-hidden shadow-xl bg-linear-to-r form-gray-400 to-gray-400">
            <div class="px-6 py-4">
                <div class="font-bold text-xl mb-2 text-black">Total Sales</div>
                <p class="text-black text-base">
                    <%= @quick_stats[:sales] ? @quick_stats[:sales].to_s : "0" %>
                </p>
            </div>
        </div>
        <div class="max-w-sm rounded overflow-hidden shadow-xl bg-linear-to-r form-gray-400 to-gray-400">
            <div class="px-6 py-4">
                <div class="font-bold text-xl mb-2 text-black">Average Sale</div>
                <p class="text-black text-base">
                    $<%= @quick_stats[:avg_sale] ? (@quick_stats[:avg_sale]/100.0).to_s : "0" %>
                </p>
            </div>
        </div>
        <div class="max-w-sm rounded overflow-hidden shadow-xl bg-linear-to-r form-gray-400 to-gray-400">
            <div class="px-6 py-4">
                <div class="font-bold text-xl mb-2 text-black">Items per Sale</div>
                <p class="text-black text-base">
                    <%= @quick_stats[:per_sale] ? @quick_stats[:per_sale].to_i : "0" %>
                </p>
            </div>
        </div>
    </div>
    </div>
    <div data-controller="dashboard" class="mt-8 w-full max-w-4xl">
        <canvas id="revenueChart"></canvas>
    </div>
</div>
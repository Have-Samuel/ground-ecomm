<h1>Admin Dashboard</h1>

<div class="flex justify-between flex-wrap mt-8 w-full items-center max-w-4xl">
    <h2 class="text-2xl tect-gray-800 font-meduim mb-4"> Daily Stats</h2>
    <div class="flex gap-10 flex-col md:flex-row justify-between w-full">
        <div class="max-w-sm rounded overflow-hidden shadow-xl bg-linear-to-r form-gray-400 to-gray-400">
            <div class="px-6 py-4">
                <div class="font-bold text-xl mb-2 text-black">Revenue</div>
                <p class="text-black text-base">
                    $<%= @quick_stats[:revenue] ? (@quick_stats[:revenue]/100.0).to_s : "0" %>
                </p>
            </div>
        </div>
        <div class="max-w-sm rounded overflow-hidden shadow-xl bg-linear-to-r form-gray-400 to-gray-400">
            <div class="px-6 py-4">
                <div class="font-bold text-xl mb-2 text-black">Total Sales</div>
                <p class="text-black text-base">
                    <%= @quick_stats[:sales] ? @quick_stats[:sales].to_s : "0" %>
                </p>
            </div>
        </div>
        <div class="max-w-sm rounded overflow-hidden shadow-xl bg-linear-to-r form-gray-400 to-gray-400">
            <div class="px-6 py-4">
                <div class="font-bold text-xl mb-2 text-black">Average Sale</div>
                <p class="text-black text-base">
                    $<%= @quick_stats[:avg_sale] ? (@quick_stats[:avg_sale]/100.0).to_s : "0" %>
                </p>
            </div>
        </div>
        <div class="max-w-sm rounded overflow-hidden shadow-xl bg-linear-to-r form-gray-400 to-gray-400">
            <div class="px-6 py-4">
                <div class="font-bold text-xl mb-2 text-black">Items per Sale</div>
                <p class="text-black text-base">
                    <%= @quick_stats[:per_sale] ? @quick_stats[:per_sale].to_i : "0" %>
                </p>
            </div>
        </div>
    </div>
    </div>

    <!--CHART-->
<div data-controller="dashboard">
        <canvas id="revenueChart"></canvas>
</div>

    <div class="flex flex-col w-full">
        <h2 class="text-2xl text-gray-700 mb-4 font-medium">Recent Unfulfilled Orders</h2>
        <div class="overflow-x-auto">
            <table class="min-w-full bg-gray-100" style="border-collapse:seperate; border-spacing:0;">
                <thead>
                    <tr class="text-gray-800">
                        <th class="px-6 py-3 border-b-2 border-gray-200 bg-gray-100">Order ID</th>
                        <th class="px-6 py-3 border-b-2 border-gray-200 bg-gray-100">Customer</th>
                        <th class="px-6 py-3 border-b-2 border-gray-200 bg-gray-100">Date</th>
                        <th class="px-6 py-3 border-b-2 border-gray-200 bg-gray-100">Amount</th>
                    </tr>
            </thead>
                <tbody class="text-gray-700">
                    <% @orders.each do |order| %>
                    <tr>
                    <td class="px-6 py-4 border-b border-gray-200">
                        <%= link_to order.id, admin_order_path(order), class: "underline" %>                       
                    </td>
                    <td class="px-6 py-4 border-b border-gray-200">
                        <%= order.customer_email %>
                    </td>
                    <td class="px-6 py-4 border-b border-gray-200">
                        <%= order.created_at.strftime("%B %d, %Y %H:%M")%>
                    </td>
                    <td class="px-6 py-4 border-b border-gray-200">
                        <%= (order.total/100.0).to_s %>
                    </td>
                    </tr>
                    <% end %>
                </tbody>
                </table>
        </div>
    </div>


